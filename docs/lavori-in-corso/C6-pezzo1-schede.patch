+<script>
+/* C6 · app a 4 schede in basso (Mario 22/11). Le sezioni restano dove sono nel file, con gli stessi id: il motore della scelta continua a funzionare. Qui si dice solo in che scheda va ognuna. Se questo pezzo si rompe, la pagina resta quella lunga di prima. */
+(()=>{
+const T=[
+ {k:'piano',i:'🏠',n:'Piano',s:[['breve','In breve'],['costi','Costi'],['dafare','Da fare'],['ricontrollare','Da ricontrollare']]},
+ {k:'dormire',i:'🛏️',n:'Dormire',s:[['scegli','Scegli dove dormire'],['hotel','Tutti gli alloggi'],['hoteldisney','Hotel Disney']]},
+ {k:'giorni',i:'📅',n:'Giorni',s:[['giorni','Giorno per giorno'],['mercatini','Giro dei mercatini']]},
+ {k:'biglietti',i:'🎟️',n:'Biglietti',s:[['biglietti','Biglietti Disney'],['trasporti','Treni e ticket'],['fonti','Fonti']]}];
+const main=document.querySelector('main');if(!main)return;
+const RM=matchMedia('(prefers-reduced-motion: reduce)').matches;
+T.forEach(t=>t.s.forEach(([id])=>{const e=document.getElementById(id);if(e)e.dataset.tab=t.k}));
+main.querySelectorAll(':scope>section').forEach(s=>{if(!s.dataset.tab)s.dataset.tab='piano'});
+/* nella scheda Giorni prima i giorni, poi il giro dei mercatini della domenica */
+{const g=document.getElementById('giorni'),m=document.getElementById('mercatini');if(g&&m)main.insertBefore(g,m)}
+const bar=document.createElement('nav');bar.className='tabbar';bar.id='tabbar';bar.setAttribute('aria-label','Parti della guida');bar.setAttribute('role','tablist');
+bar.innerHTML=T.map(t=>`<button type="button" role="tab" data-t="${t.k}" aria-selected="false"><span class="i" aria-hidden="true">${t.i}</span>${t.n}</button>`).join('');
+document.body.appendChild(bar);
+const side=document.querySelector('.side');
+const tabOf=el=>{const s=el.closest('main>section');if(s)return s.dataset.tab;return el.closest('header.hero')?'piano':null};
+let cur=null;const pos={};
+const show=(k,o={})=>{
+ if(!T.some(t=>t.k===k))k='piano';
+ if(cur&&cur!==k)pos[cur]=scrollY;
+ const same=cur===k;cur=k;document.body.dataset.tab=k;
+ main.querySelectorAll(':scope>section').forEach(s=>s.classList.toggle('tab-on',s.dataset.tab===k));
+ bar.querySelectorAll('button').forEach(b=>b.setAttribute('aria-selected',b.dataset.t===k?'true':'false'));
+ if(side)side.innerHTML='<p>Guida</p>'+T.map(t=>`<a href="#" class="st" data-t="${t.k}"${t.k===k?' aria-current="true"':''}>${t.i} ${t.n}</a>`+(t.k===k?t.s.map(([id,n])=>`<a class="ss" href="#${id}">${n}</a>`).join(''):'')).join('');
+ try{localStorage.setItem('pdn-scheda',k)}catch(e){}
+ dispatchEvent(new Event('resize'));
+ if(!o.keep)scrollTo({top:same?0:(pos[k]||0),behavior:'auto'});
+};
+const go=(id,smooth)=>{const el=document.getElementById(id);if(!el)return false;const k=tabOf(el);if(!k)return false;if(k!==cur)show(k,{keep:true});requestAnimationFrame(()=>el.scrollIntoView({behavior:smooth&&!RM?'smooth':'auto',block:'start'}));return true};
+bar.addEventListener('click',e=>{const b=e.target.closest('button[data-t]');if(b)show(b.dataset.t)});
+bar.addEventListener('keydown',e=>{const bs=[...bar.querySelectorAll('button')],i=bs.indexOf(document.activeElement);if(i<0)return;let j=null;if(e.key==='ArrowRight')j=(i+1)%bs.length;if(e.key==='ArrowLeft')j=(i+bs.length-1)%bs.length;if(j!==null){e.preventDefault();bs[j].focus();show(bs[j].dataset.t)}});
+if(side)side.addEventListener('click',e=>{const a=e.target.closest('a.st');if(a){e.preventDefault();show(a.dataset.t)}});
+/* ogni link interno (#scegli, #mercatini, «Scheda»…) apre prima la scheda giusta */
+document.addEventListener('click',e=>{const a=e.target.closest('a[href^="#"]');if(!a||a.classList.contains('st'))return;const id=decodeURIComponent(a.getAttribute('href').slice(1));if(!id)return;if(go(id,true))e.preventDefault()},true);
+/* se il motore porta lo schermo su una parte nascosta (es. una scheda d'alloggio dai costi), prima apre la sua scheda */
+{const siv=Element.prototype.scrollIntoView;Element.prototype.scrollIntoView=function(o){const k=tabOf(this);if(k&&k!==cur)show(k,{keep:true});return siv.call(this,o)}}
+let first=null;try{first=localStorage.getItem('pdn-scheda')}catch(e){}
+const h=decodeURIComponent(location.hash.slice(1));
+if(h&&document.getElementById(h)){show(tabOf(document.getElementById(h))||'piano',{keep:true});requestAnimationFrame(()=>document.getElementById(h).scrollIntoView({block:'start'}))}
+else show(first||'piano',{keep:true});
+})();
+</script>
